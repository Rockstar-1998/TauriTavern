{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TauriTavern",
  "version": "1.4.3",
  "identifier": "com.tauritavern.client",
  "build": {
    "frontendDist": "../frontend/dist",
    "removeUnusedCommands": false,
    "beforeBuildCommand": "npm --prefix frontend run build:bundle"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TauriTavern",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "label": "main",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPCACHE/*",
          "$APPDATA/**",
          "$APPDATA/*",
          "$APPLOCALDATA/**",
          "$APPLOCALDATA/*",
          "$LOCALDATA/**",
          "$LOCALDATA/*",
          "$RESOURCE/**",
          "$RESOURCE/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../default/": "default/",
      "../src/scripts/templates/": "frontend-templates/"
    },
    "android": {
      "versionCode": 1004003
    }
  }
}